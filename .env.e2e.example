E2E_FRONTEND_URL=http://localhost:3000
E2E_BACKEND_URL=http://localhost:3002
E2E_AI_SERVICE_URL=http://localhost:8000

# Keep real credentials out of this file and inject them from your shell/CI secret store.
E2E_TEACHER_USERNAME=
E2E_TEACHER_PASSWORD=
E2E_STUDENT_USERNAME=
E2E_STUDENT_PASSWORD=

# An absolute local path to a PDF, DOCX, MD, or TXT source document.
E2E_DOCUMENT_PATH=/absolute/path/to/material.docx
E2E_SUBJECT=math8
E2E_TOPIC=polynomials
E2E_CONCEPT=monomials

# Live creation may exceed normal UI latency budgets. The default is 10 minutes.
E2E_GENERATION_TIMEOUT_MS=600000
